{
  "name": "ropm",
  "version": "0.11.11",
  "description": "",
  "scripts": {
    "preversion": "npm run build && npm run lint && npm run test",
    "build": "tsc",
    "lint": "eslint \"src/**\"",
    "test": "c8 mocha",
    "test:nocover": "mocha",
    "audit": "npm audit || audit-ci --config ./audit-ci.jsonc",
    "package": "npm run build && npm pack"
  },
  "engines": {
    "node": ">=8.1.10"
  },
  "engineStrict": true,
  "main": "dist/cli.js",
  "typings": "dist/index.d.ts",
  "bin": {
    "ropm": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "author": "Bronley Plumb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rokucommunity/ropm"
  },
  "bugs": {
    "url": "https://github.com/rokucommunity/ropm/issues"
  },
  "homepage": "https://github.com/rokucommunity/ropm",
  "dependencies": {
    "@rokucommunity/logger": "^0.4.2",
    "@xml-tools/parser": "1.0.10",
    "brighterscript": "^0.73.3",
    "del": "6.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "9.1.0",
    "latinize": "0.5.0",
    "npm-packlist": "2.1.4",
    "roku-deploy": "^3.18.4",
    "semver": "^7.6.3",
    "yargs": "16.2.0"
  },
  "devDependencies": {
    "@types/chai": "^4.2.15",
    "@types/fs-extra": "^9.0.7",
    "@types/latinize": "^0.2.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^14.14.28",
    "@types/npm-packlist": "^1.1.1",
    "@types/semver": "^7.3.4",
    "@types/sinon": "^10.0.20",
    "@types/yargs": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^5.27.0",
    "@typescript-eslint/parser": "^5.27.0",
    "audit-ci": "^7.1.0",
    "c8": "^10.1.3",
    "chai": "^4.3.4",
    "eslint": "^8.16.0",
    "eslint-plugin-github": "^4.1.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^39.3.6",
    "eslint-plugin-no-only-tests": "^2.6.0",
    "mocha": "^11.1.0",
    "pnpm": "10.34.5",
    "sinon": "^18.0.0",
    "source-map-support": "^0.5.20",
    "ts-node": "^10.4.0",
    "typescript": "^5.4.5"
  },
  "c8": {
    "include": [
      "src/**/*.ts",
      "!src/**/*.spec.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "text-summary",
      "html",
      "lcovonly"
    ],
    "check-coverage": false,
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100
  },
  "overrides": {
    "serialize-javascript": "^7",
    "vscode-languageserver-protocol": "3.17.5"
  }
}
